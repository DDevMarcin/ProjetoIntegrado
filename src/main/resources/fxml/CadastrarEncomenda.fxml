<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.managementsystem.demo1.controller.CadastrarEncomendaController"
            style="-fx-background-color: #FFF8FB;">

    <padding>
        <Insets top="32" right="32" bottom="24" left="32"/>
    </padding>

    <top>
        <VBox spacing="0">
            <HBox fx:id="bannerSucesso"
                  visible="false" managed="false"
                  alignment="CENTER" spacing="12"
                  style="-fx-background-color: #2e7d32; -fx-padding: 16 28 16 28;">
                <Label text="✔" style="-fx-font-size: 22px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="bannerMensagem" text="" wrapText="true"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <VBox spacing="4" style="-fx-padding: 0 0 20 0;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="&#8592; Voltar" onAction="#voltar" styleClass="btn-voltar"/>
                    <VBox spacing="2">
                        <Label text="Nova Encomenda"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Informe o cliente e adicione os itens da encomenda"
                               style="-fx-font-size: 15px; -fx-text-fill: #999;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="24">

            <!-- Formulário -->
            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="form-scroll">
                <content>
                    <VBox spacing="16" style="-fx-padding: 28; -fx-background-color: white;
                                              -fx-background-radius: 12; -fx-border-color: #f0d0da;
                                              -fx-border-radius: 12; -fx-border-width: 1;">

                        <!-- Cliente -->
                        <Label text="Cliente"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                        <VBox spacing="6">
                            <Label styleClass="form-label-required" text="Nome do cliente *"/>
                            <TextField fx:id="campoCliente" promptText="Ex.: Maria Silva" styleClass="form-field"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label styleClass="form-label" text="Contato (opcional)"/>
                            <TextField fx:id="campoContato" promptText="Ex.: (88) 99999-9999"
                                       prefWidth="260" styleClass="form-field"/>
                        </VBox>

                        <Separator/>

                        <!-- Seletor de Tipo de Item -->
                        <Label text="Novo item"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>

                        <VBox spacing="8">
                            <Label styleClass="form-label-required" text="Tipo de item *"/>
                            <HBox spacing="24">
                                <RadioButton fx:id="rbTipoPersonalizado" text="Item Personalizado" styleClass="form-radio"/>
                                <RadioButton fx:id="rbTipoPrePronto" text="Produto Pré-Pronto" styleClass="form-radio"/>
                            </HBox>
                        </VBox>

                        <!-- Seção Pré-Pronto -->
                        <VBox fx:id="secaoPrePronto" spacing="10"
                              visible="false" managed="false"
                              style="-fx-background-color: #FFF8FB; -fx-padding: 14; -fx-background-radius: 10; -fx-border-color: #f0d0da; -fx-border-radius: 10;">
                            <Label text="Selecionar Produto Pré-Pronto"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-label" text="Produto cadastrado *"/>
                                    <ComboBox fx:id="comboProdutoPrePronto" promptText="Escolha um produto pré-pronto..."
                                              maxWidth="Infinity" styleClass="form-field"/>
                                </VBox>
                                <VBox spacing="4" prefWidth="110">
                                    <Label styleClass="form-label" text="Quantidade *"/>
                                    <TextField fx:id="campoQtdPrePronto" text="1" promptText="Ex.: 1" styleClass="form-field"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="labelInfoPrePronto" text="Selecione um produto para ver detalhes e estoque."
                                   wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                        </VBox>

                        <!-- Seção Personalizado -->
                        <VBox fx:id="secaoPersonalizado" spacing="14">
                            <VBox spacing="6">
                                <Label styleClass="form-label-required" text="Nome do item *"/>
                                <TextField fx:id="campoNome" promptText="Ex.: Terço Personalizado" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label styleClass="form-label" text="Descrição"/>
                                <TextArea fx:id="campoDescricao" promptText="Descreva o item..."
                                          prefRowCount="2" wrapText="true" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label styleClass="form-label" text="Prazo de Produção (dias)"/>
                                <TextField fx:id="campoPrazo" promptText="Ex.: 7" prefWidth="160" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="6">
                                <Label styleClass="form-label" text="Observações"/>
                                <TextArea fx:id="campoObservacoes" promptText="Informações adicionais..."
                                          prefRowCount="2" wrapText="true" styleClass="form-field"/>
                            </VBox>

                            <VBox spacing="10">
                                <Label text="Valor do item"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                                <HBox spacing="24">
                                    <RadioButton fx:id="rbPrecoMateriais" text="Calcular pelos materiais" styleClass="form-radio"/>
                                    <RadioButton fx:id="rbPrecoManual" text="Informar valor" styleClass="form-radio"/>
                                </HBox>
                                <VBox spacing="6">
                                    <Label styleClass="form-label" text="Valor do item (R$)"/>
                                    <TextField fx:id="campoValorManual" promptText="Ex.: 45,00"
                                               prefWidth="160" styleClass="form-field"/>
                                </VBox>
                            </VBox>

                            <VBox fx:id="secaoMateriais" spacing="10">
                                <Label text="Materiais do item"
                                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <ComboBox fx:id="comboMaterial" promptText="Selecione o material"
                                              prefWidth="260" styleClass="form-field"/>
                                    <TextField fx:id="campoQtdMaterial" promptText="Qtd." prefWidth="80" styleClass="form-field"/>
                                    <Button text="+ Adicionar" onAction="#adicionarMaterial" styleClass="btn-adicionar"/>
                                </HBox>
                                <FlowPane fx:id="listaMateriais" hgap="8" vgap="8" style="-fx-padding: 4 0 0 0;"/>
                            </VBox>
                        </VBox>

                        <Label fx:id="labelValorItem" text="Valor do item: R$ —"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #8F031E;"/>

                        <HBox alignment="CENTER_RIGHT">
                            <Button text="+ Adicionar item à encomenda" onAction="#adicionarItem"
                                    styleClass="btn-adicionar"/>
                        </HBox>

                        <Separator/>

                        <!-- Itens já adicionados -->
                        <Label text="Itens da encomenda"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                        <VBox fx:id="listaItens" spacing="8"/>

                        <Label fx:id="labelStatus" wrapText="true" style="-fx-font-size: 15px;"/>

                        <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                            <Button text="Limpar" onAction="#limpar" styleClass="btn-voltar"/>
                            <Button text="&#10003;  Cadastrar Encomenda" onAction="#salvar" styleClass="btn-salvar"/>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

            <!-- Preview -->
            <VBox spacing="14"
                  prefWidth="320" minWidth="300" maxWidth="340"
                  style="-fx-background-color: #FFF0F5; -fx-background-radius: 12;
                         -fx-border-color: #f0d0da; -fx-border-radius: 12;
                         -fx-border-width: 1; -fx-padding: 20;">

                <Label fx:id="previewCliente" text="Cliente" wrapText="true"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>

                <Separator/>

                <VBox spacing="8">
                    <Label text="Itens" styleClass="detalhe-secao-titulo"/>
                    <VBox fx:id="previewItens" spacing="6"/>
                </VBox>

                <Separator/>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Subtotal:" styleClass="detalhe-info-label"/>
                    <Label fx:id="previewSubtotal" text="R$ —" styleClass="detalhe-info-valor"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Total (+20%):" styleClass="detalhe-info-label"/>
                    <Label fx:id="previewTotal" text="R$ —" styleClass="detalhe-valor"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Entrega prevista:" styleClass="detalhe-info-label"/>
                    <Label fx:id="previewEntrega" text="—" styleClass="detalhe-info-valor"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>

        </HBox>
    </center>

</BorderPane>