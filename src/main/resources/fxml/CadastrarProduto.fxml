<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.managementsystem.demo1.controller.CadastrarProdutoUnificadoController"
            style="-fx-background-color: #FFF8FB;">

    <padding>
        <Insets top="32" right="32" bottom="24" left="32"/>
    </padding>

    <!-- ── BANNER DE SUCESSO (sobreposto, oculto por padrão) ── -->
    <top>
        <VBox spacing="0">

            <!-- Banner verde de sucesso -->
            <HBox fx:id="bannerSucesso"
                  visible="false" managed="false"
                  alignment="CENTER"
                  spacing="12"
                  style="-fx-background-color: #2e7d32; -fx-padding: 16 28 16 28;">
                <Label text="✔"
                       style="-fx-font-size: 22px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="bannerMensagem"
                       text=""
                       wrapText="true"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <!-- Cabeçalho normal da tela -->
            <VBox spacing="4" style="-fx-padding: 0 0 20 0;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="&#8592; Voltar"
                            onAction="#voltar"
                            styleClass="btn-voltar"/>
                    <VBox spacing="2">
                        <Label text="Cadastrar Produto"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        <Label text="Preencha as informações do produto abaixo"
                               style="-fx-font-size: 15px; -fx-text-fill: #999;"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </top>

    <!-- ── CENTER: formulário (esq) + preview (dir) ── -->
    <center>
        <HBox spacing="24">

            <!-- ════ FORMULÁRIO ════ -->
            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="form-scroll">
                <content>
                    <VBox spacing="16" style="-fx-padding: 28; -fx-background-color: white;
                                              -fx-background-radius: 12; -fx-border-color: #f0d0da;
                                              -fx-border-radius: 12; -fx-border-width: 1;">

                        <!-- Código -->
                        <VBox spacing="6">
                            <Label styleClass="form-label-required" text="Código do Produto *"/>
                            <TextField fx:id="campoCodigo"
                                       promptText="Ex.: TP-001"
                                       styleClass="form-field"/>
                        </VBox>

                        <!-- Nome -->
                        <VBox spacing="6">
                            <Label styleClass="form-label-required" text="Nome do Produto *"/>
                            <TextField fx:id="campoNome"
                                       promptText="Ex.: Terço dos Homens"
                                       styleClass="form-field"/>
                        </VBox>

                        <!-- Descrição -->
                        <VBox spacing="6">
                            <Label styleClass="form-label" text="Descrição"/>
                            <TextArea fx:id="campoDescricao"
                                      promptText="Descreva o produto..."
                                      prefRowCount="3"
                                      wrapText="true"
                                      styleClass="form-field"/>
                        </VBox>

                        <!-- Quantidade em estoque -->
                        <VBox fx:id="secaoPrePronto" spacing="6">
                            <Label styleClass="form-label-required" text="Quantidade em Estoque *"/>
                            <TextField fx:id="campoQuantidade"
                                       promptText="Ex.: 10"
                                       prefWidth="160"
                                       styleClass="form-field"/>
                        </VBox>

                        <Separator/>

                        <!-- ── Preço de venda ── -->
                        <VBox spacing="10">
                            <Label text="Preço de Venda"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                            <HBox spacing="24">
                                <RadioButton fx:id="rbPrecoMateriais"
                                             text="Calcular pelos materiais"
                                             styleClass="form-radio"/>
                                <RadioButton fx:id="rbPrecoManual"
                                             text="Valor total"
                                             styleClass="form-radio"/>
                            </HBox>
                            <VBox spacing="6">
                                <Label styleClass="form-label" text="Valor total (R$)"/>
                                <TextField fx:id="campoValorManual"
                                           promptText="Ex.: 45,00"
                                           prefWidth="160"
                                           styleClass="form-field"/>
                            </VBox>
                        </VBox>

                        <Separator/>

                        <!-- ── Materiais utilizados ── -->
                        <VBox fx:id="secaoMateriais" spacing="10">
                            <Label text="Materiais Utilizados"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ComboBox fx:id="comboMaterial"
                                          promptText="Selecione o material"
                                          prefWidth="260"
                                          styleClass="form-field"/>
                                <TextField fx:id="campoQtdMaterial"
                                           promptText="Qtd."
                                           prefWidth="80"
                                           styleClass="form-field"/>
                                <Button text="+ Adicionar"
                                        onAction="#adicionarMaterial"
                                        styleClass="btn-adicionar"/>
                            </HBox>
                            <FlowPane fx:id="listaMateriais" hgap="8" vgap="8"
                                      style="-fx-padding: 4 0 0 0;"/>
                        </VBox>

                        <!-- Status -->
                        <Label fx:id="labelStatus" wrapText="true"
                               style="-fx-font-size: 15px;"/>

                        <!-- Botões -->
                        <HBox spacing="12" alignment="CENTER_RIGHT"
                              style="-fx-padding: 8 0 0 0;">
                            <Button text="Limpar"
                                    onAction="#limpar"
                                    styleClass="btn-voltar"/>
                            <Button text="&#10003;  Cadastrar Produto"
                                    onAction="#salvar"
                                    styleClass="btn-salvar"/>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

            <!-- ════ PREVIEW ════ -->
            <VBox spacing="14"
                  prefWidth="320" minWidth="300" maxWidth="340"
                  style="-fx-background-color: #FFF0F5; -fx-background-radius: 12;
                         -fx-border-color: #f0d0da; -fx-border-radius: 12;
                         -fx-border-width: 1; -fx-padding: 20;">

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="previewNome"
                           text="Nome do produto"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D31946;"
                           wrapText="true" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="previewCodigo" text="—" styleClass="detalhe-codigo-badge"/>
                </HBox>

                <Separator/>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Valor:" styleClass="detalhe-info-label"/>
                    <Label fx:id="previewValor" text="R$ —" styleClass="detalhe-valor"/>
                </HBox>

                <HBox fx:id="previewSecaoQtd" alignment="CENTER_LEFT" spacing="8">
                    <Label text="Estoque:" styleClass="detalhe-info-label"/>
                    <Label fx:id="previewQuantidade" text="—" styleClass="detalhe-info-valor"/>
                </HBox>

                <Separator/>

                <VBox spacing="4">
                    <Label text="Descricao" styleClass="detalhe-secao-titulo"/>
                    <Label fx:id="previewDescricao"
                           text="Sem descricao."
                           wrapText="true"
                           styleClass="detalhe-secao-texto"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Materiais utilizados" styleClass="detalhe-secao-titulo"/>
                    <FlowPane fx:id="previewMateriais" hgap="8" vgap="8"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

            </VBox>

        </HBox>
    </center>

</BorderPane>
