<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.managementsystem.demo1.controller.EncomendasController"
            style="-fx-background-color: #FFF8FB;">

    <padding>
        <Insets top="32" right="32" bottom="24" left="32"/>
    </padding>

    <!-- ── TOP ── -->
    <top>
        <VBox spacing="0">
            <Label text="Encomendas"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 16 0 16 0;">
                <TextField fx:id="campoBusca"
                           promptText="Buscar por ID, cliente ou item..."
                           prefWidth="300"
                           styleClass="busca-field"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Histórico de Entregas"
                        onAction="#abrirHistorico"
                        styleClass="btn-voltar"/>
                <Button text="+ Nova Encomenda"
                        onAction="#abrirFormCadastro"
                        styleClass="btn-criar"/>
            </HBox>
        </VBox>
    </top>

    <!-- ── CENTER: tabela + painel de detalhes ── -->
    <center>
        <HBox spacing="16">

            <!-- Tabela -->
            <VBox spacing="0" styleClass="card-tabela" HBox.hgrow="ALWAYS">

                <Label text="Lista de Encomendas" styleClass="card-titulo"/>

                <TableView fx:id="tabelaEncomendas"
                           VBox.vgrow="ALWAYS"
                           styleClass="tabela-produtos">
                    <columns>
                        <TableColumn fx:id="colId"       text="ID"               prefWidth="65"/>
                        <TableColumn fx:id="colCliente"  text="Cliente"          prefWidth="185"/>
                        <TableColumn fx:id="colItens"    text="Itens"            prefWidth="170"/>
                        <TableColumn fx:id="colEntrega"  text="Entrega Prevista" prefWidth="125"/>
                        <TableColumn fx:id="colSituacao" text="Situação"         prefWidth="125"/>
                        <TableColumn fx:id="colValor"    text="Total (+20%)"     prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="Nenhuma encomenda ativa encontrada." style="-fx-text-fill: #aaa;"/>
                    </placeholder>
                </TableView>

                <!-- Rodapé -->
                <HBox alignment="CENTER_LEFT" styleClass="rodape-tabela">
                    <Label fx:id="labelTotal" text="Total: 0" styleClass="rodape-label-total"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="6" alignment="CENTER">
                        <Button fx:id="btnAnterior" text="&#8249;" onAction="#paginaAnterior" styleClass="btn-pagina"/>
                        <Label  fx:id="labelPagina" text="Página 1"                           styleClass="rodape-label-pagina"/>
                        <Button fx:id="btnProximo"  text="&#8250;" onAction="#proximaPagina"  styleClass="btn-pagina"/>
                    </HBox>
                </HBox>

            </VBox>

            <!-- Painel de detalhes -->
            <ScrollPane fx:id="painelDetalhes"
                        fitToWidth="true"
                        prefWidth="350" minWidth="350" maxWidth="350"
                        visible="false" managed="false"
                        styleClass="painel-detalhes-scroll">
                <content>
                    <VBox spacing="12" style="-fx-padding: 20;">

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="detCliente" text="—" styleClass="detalhe-nome"
                                   HBox.hgrow="ALWAYS" wrapText="true"/>
                            <Label fx:id="detSituacao" text="—" styleClass="detalhe-codigo-badge"/>
                        </HBox>

                        <Label fx:id="detContato" text="—" styleClass="detalhe-info-valor"/>

                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Subtotal:" styleClass="detalhe-info-label"/>
                            <Label fx:id="detSubtotal" text="R$ —" styleClass="detalhe-info-valor"/>
                        </HBox>

                        <Label fx:id="detValorTotal" text="R$ —" styleClass="detalhe-valor"/>

                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Pedido em:" styleClass="detalhe-info-label"/>
                            <Label fx:id="detDataPedido" text="—" styleClass="detalhe-info-valor"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Entrega prevista:" styleClass="detalhe-info-label"/>
                            <Label fx:id="detDataEntrega" text="—" styleClass="detalhe-info-valor"/>
                        </HBox>

                        <Separator/>

                        <VBox styleClass="detalhe-secao" spacing="6">
                            <Label text="Itens da encomenda" styleClass="detalhe-secao-titulo"/>
                            <VBox fx:id="painelItens" spacing="8"/>
                        </VBox>

                        <VBox styleClass="detalhe-secao" spacing="6">
                            <Label text="Observações" styleClass="detalhe-secao-titulo"/>
                            <Label fx:id="detObservacoes" text="—" wrapText="true"
                                   styleClass="detalhe-secao-texto"/>
                        </VBox>

                        <Separator/>

                        <!-- Ações de status -->
                        <VBox spacing="8">
                            <Button fx:id="btnAvancarSituacao"
                                    text="Avançar Situação"
                                    onAction="#avancarSituacao"
                                    maxWidth="Infinity"
                                    styleClass="btn-editar"/>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Button text="Deletar"
                                        onAction="#deletarEncomenda"
                                        styleClass="btn-deletar"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnCancelarEncomenda"
                                        text="Cancelar Encomenda"
                                        onAction="#cancelarEncomenda"
                                        styleClass="btn-voltar"/>
                            </HBox>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>

        </HBox>
    </center>

</BorderPane>