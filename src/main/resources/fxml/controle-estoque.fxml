<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.managementsystem.demo1.controller.ControleEstoqueController">

    <content>
        <VBox spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Cabeçalho -->
            <Label text="Controle de Estoque"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <Label text="Consulta e visualização de produtos sob controle de estoque (Pré-prontos)"
                   style="-fx-font-size: 13px; -fx-text-fill: #666;"/>

            <Separator/>

            <!-- Card de Totalizador -->
            <HBox alignment="CENTER_LEFT" spacing="15"
                  style="-fx-background-color: #EBF3FB; -fx-padding: 12 16 12 16; -fx-background-radius: 6; -fx-border-color: #C3DBF5; -fx-border-radius: 6;">
                <Label fx:id="labelTotalEstoque"
                       text="Total de Unidades em Estoque: 0"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #195b9d;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Atualizar Estoque"
                        onAction="#carregarTodos"
                        style="-fx-cursor: hand;"/>
            </HBox>

            <Separator/>

            <!-- Seção de Filtros e Consultas -->
            <Label text="Filtros e Consulta de Produtos:"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <!-- Busca por Nome -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Buscar por nome:" prefWidth="120"/>
                <TextField fx:id="campoBuscaNome"
                           promptText="Ex.: Terço de madeira"
                           HBox.hgrow="ALWAYS"
                           onAction="#buscarPorNome"/>
                <Button text="Buscar por Nome"
                        onAction="#buscarPorNome"
                        style="-fx-cursor: hand;"/>
            </HBox>

            <!-- Busca por ID -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Buscar por ID:" prefWidth="120"/>
                <TextField fx:id="campoBuscaId"
                           promptText="Ex.: 1"
                           prefWidth="150"
                           onAction="#buscarPorId"/>
                <Button text="Buscar por ID"
                        onAction="#buscarPorId"
                        style="-fx-cursor: hand;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Listar Todo o Estoque"
                        onAction="#carregarTodos"
                        style="-fx-cursor: hand;"/>
                <Button text="Limpar Filtros"
                        onAction="#limparFiltros"
                        style="-fx-cursor: hand;"/>
            </HBox>

            <!-- Mensagem de Status -->
            <Label fx:id="labelStatus"
                   text="Pronto."
                   wrapText="true"
                   style="-fx-text-fill: #333; -fx-font-style: italic; -fx-padding: 4 0 4 0;"/>

            <Separator/>

            <!-- Lista de Produtos em Estoque -->
            <Label text="Produtos em Estoque (PRE_PRONTO):"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <ListView fx:id="listaProdutosEstoque"
                      prefHeight="200"/>

            <Separator/>

            <!-- Painel de Detalhes do Produto Selecionado -->
            <Label text="Detalhes do Produto Selecionado:"
                   style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

            <GridPane hgap="12" vgap="6"
                      style="-fx-background-color: #FAFAFA; -fx-padding: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 4; -fx-background-radius: 4;">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" prefWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="labelDetalhesId" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Código:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="labelDetalhesCodigo" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Nome:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="labelDetalhesNome" text="—" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Preço de Venda:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="labelDetalhesPreco" text="—" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Qtd. em Estoque:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="labelDetalhesQuantidade" text="—" GridPane.rowIndex="4" GridPane.columnIndex="1"
                       style="-fx-font-weight: bold; -fx-text-fill: #195b9d;"/>

                <Label text="Descrição:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="labelDetalhesDescricao" text="—" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Materiais Usados:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="labelDetalhesMateriais" text="—" wrapText="true" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>

        </VBox>
    </content>
</ScrollPane>
