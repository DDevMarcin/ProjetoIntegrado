<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.managementsystem.demo1.controller.FinanceiroController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background-color: #FFF8FB; -fx-background: #FFF8FB;">

    <content>
        <HBox spacing="20" minHeight="600" style="-fx-background-color: #FFF8FB;">
            <padding>
                <Insets top="24" right="28" bottom="28" left="28"/>
            </padding>

            <!-- COLUNA PRINCIPAL (ESQUERDA) -->
            <VBox spacing="14" HBox.hgrow="ALWAYS">

                <!-- Cabeçalho -->
                <VBox spacing="2">
                    <Label text="Financeiro"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label text="Controle de receitas, despesas e fluxo de caixa"
                           style="-fx-font-size: 13px; -fx-text-fill: #777;"/>
                </VBox>

                <!-- Período de análise -->
                <VBox spacing="8">
                    <Label fx:id="lblPeriodoTitulo" text="Período de análise"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="btnPeriodoSemanal" text="Semanal" onAction="#selecionarSemanal"
                                style="-fx-background-radius: 8; -fx-padding: 5 14; -fx-font-size: 12px; -fx-cursor: hand;"/>
                        <Button fx:id="btnPeriodoMensal" text="Mensal" onAction="#selecionarMensal"
                                style="-fx-background-radius: 8; -fx-padding: 5 14; -fx-font-size: 12px; -fx-cursor: hand;"/>
                        <Button fx:id="btnPeriodoAnual" text="Anual" onAction="#selecionarAnual"
                                style="-fx-background-radius: 8; -fx-padding: 5 14; -fx-font-size: 12px; -fx-cursor: hand;"/>
                        <Button fx:id="btnPeriodoPersonalizado" text="Personalizado" onAction="#selecionarPersonalizado"
                                style="-fx-background-radius: 8; -fx-padding: 5 14; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    </HBox>

                    <!-- Datas personalizadas -->
                    <HBox fx:id="boxDatasPersonalizadas" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
                        <Label text="De:" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                        <DatePicker fx:id="dpInicio" prefWidth="130" onAction="#aplicarDatasPersonalizadas"/>
                        <Label text="Até:" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                        <DatePicker fx:id="dpFim" prefWidth="130" onAction="#aplicarDatasPersonalizadas"/>
                    </HBox>
                </VBox>

                <!-- Detalhamento Financeiro (Filtros de tipo) -->
                <VBox spacing="8">
                    <Label text="Detalhamento Financeiro"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>

                    <HBox spacing="8">
                        <Button fx:id="btnFiltroTodos" text="Fluxo de caixa" onAction="#filtrarTodos"
                                style="-fx-background-radius: 8; -fx-padding: 5 14; -fx-font-size: 12px; -fx-cursor: hand;"/>
                        <Button fx:id="btnFiltroReceitas" text="Receitas" onAction="#filtrarReceitas"
                                style="-fx-background-radius: 8; -fx-padding: 5 14; -fx-font-size: 12px; -fx-cursor: hand;"/>
                        <Button fx:id="btnFiltroDespesas" text="Despesas" onAction="#filtrarDespesas"
                                style="-fx-background-radius: 8; -fx-padding: 5 14; -fx-font-size: 12px; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Card Principal: Saldo Total + Entradas/Saídas -->
                <HBox alignment="CENTER_LEFT" spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16 20; -fx-border-color: #f5d6e0; -fx-border-radius: 14;">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Saldo total" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                        <Label fx:id="lblSaldoTotal" text="R$ 0,00"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                        <Label text="Resultado acumulado em caixa" style="-fx-font-size: 12px; -fx-text-fill: #888;"/>
                    </VBox>

                    <VBox spacing="10" minWidth="170">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="→" alignment="CENTER" minWidth="28" minHeight="28"
                                   style="-fx-background-color: #DCFCE7; -fx-text-fill: #16A34A; -fx-font-weight: bold; -fx-background-radius: 14;"/>
                            <VBox>
                                <Label text="Entrada" style="-fx-font-size: 11px; -fx-text-fill: #16A34A; -fx-font-weight: bold;"/>
                                <Label fx:id="lblEntradaTopo" text="R$ 0,00" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="←" alignment="CENTER" minWidth="28" minHeight="28"
                                   style="-fx-background-color: #FFE4E6; -fx-text-fill: #D31946; -fx-font-weight: bold; -fx-background-radius: 14;"/>
                            <VBox>
                                <Label text="Saída" style="-fx-font-size: 11px; -fx-text-fill: #D31946; -fx-font-weight: bold;"/>
                                <Label fx:id="lblSaidaTopo" text="R$ 0,00" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- 3 Cards de Resumo do Período -->
                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 14 16; -fx-border-color: #f5d6e0; -fx-border-radius: 12;">
                        <Label text="Receitas do Período" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
                        <Label fx:id="lblReceitasPeriodo" text="R$ 0,00"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 14 16; -fx-border-color: #f5d6e0; -fx-border-radius: 12;">
                        <Label text="Despesas e Insumos" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                        <Label fx:id="lblDespesasPeriodo" text="R$ 0,00"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 14 16; -fx-border-color: #f5d6e0; -fx-border-radius: 12;">
                        <Label text="Saldo Líquido" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                        <Label fx:id="lblSaldoLiquido" text="R$ 0,00"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </VBox>
                </HBox>

                <!-- Resumo das despesas por categoria -->
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16 18; -fx-border-color: #f5d6e0; -fx-border-radius: 14;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Resumo das despesas por categoria"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotalCategorias" text="Total: R$ 0,00"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </HBox>

                    <FlowPane fx:id="flowCategorias" hgap="10" vgap="10" style="-fx-padding: 4 0;"/>
                </VBox>

                <!-- Botões de Ação -->
                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 4 0;">
                    <Button text="+ Nova Despesa" onAction="#abrirModalNovaDespesa"
                            style="-fx-background-color: #D31946; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 9 20; -fx-cursor: hand;"/>
                    <Button text="+ Nova Receita" onAction="#abrirModalNovaReceita"
                            style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 9 20; -fx-cursor: hand;"/>
                    <Button text="Exportar Relatório (CSV)" onAction="#exportarRelatorioCsv"
                            style="-fx-background-color: white; -fx-text-fill: #1a1a2e; -fx-font-weight: bold; -fx-border-color: #ddd; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 9 18; -fx-cursor: hand;"/>
                </HBox>

            </VBox>

            <!-- COLUNA DIREITA (ÚLTIMAS MOVIMENTAÇÕES) -->
            <VBox spacing="12" prefWidth="310" minWidth="310" maxWidth="310"
                  prefHeight="750" minHeight="750" maxHeight="750"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: #f5d6e0; -fx-border-radius: 16;">
                <Label text="Últimas&#10;movimentações"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>

                <TextField fx:id="txtBuscaMovimentacao" promptText="Buscar movimentação..."
                           style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 7 12;"/>

                <VBox fx:id="boxMovimentacoes" spacing="10" style="-fx-padding: 4 2;"/>
            </VBox>

        </HBox>
    </content>

</ScrollPane>