<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.managementsystem.demo1.controller.RegistrarMovimentacaoController"
            style="-fx-background-color: #FFF8FB;">

    <padding>
        <Insets top="32" right="32" bottom="24" left="32"/>
    </padding>

    <!-- ── TOP ── -->
    <top>
        <VBox spacing="4" style="-fx-padding: 0 0 20 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button text="&#8592; Voltar"
                        onAction="#voltar"
                        styleClass="btn-voltar"/>
                <VBox spacing="2">
                    <Label fx:id="labelTitulo"
                           text="Registrar Movimentação"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label fx:id="labelSubtitulo"
                           text="Registre uma entrada, saída ou perda de material"
                           style="-fx-font-size: 15px; -fx-text-fill: #999;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- ── CENTER: formulário (esq) + info do material (dir) ── -->
    <center>
        <HBox spacing="24">

            <!-- ════ PAINEL ESQUERDO: formulário ════ -->
            <ScrollPane fitToWidth="true"
                        HBox.hgrow="ALWAYS"
                        styleClass="form-scroll">
                <content>
                    <VBox spacing="16" style="-fx-padding: 28; -fx-background-color: white;
                                              -fx-background-radius: 12; -fx-border-color: #f0d0da;
                                              -fx-border-radius: 12; -fx-border-width: 1;">

                        <!-- Material -->
                        <VBox spacing="6">
                            <Label styleClass="form-label-required" text="Material *"/>
                            <ComboBox fx:id="comboMaterial"
                                      promptText="Selecione o material"
                                      maxWidth="Infinity"
                                      styleClass="form-field"/>
                        </VBox>

                        <!-- Tipo de movimentação -->
                        <VBox spacing="10">
                            <Label styleClass="form-label-required" text="Tipo de Movimentação *"/>
                            <HBox spacing="24">
                                <RadioButton fx:id="rbEntrada" text="Entrada"  styleClass="form-radio"/>
                                <RadioButton fx:id="rbSaida"   text="Saída"    styleClass="form-radio"/>
                                <RadioButton fx:id="rbPerda"   text="Perda"    styleClass="form-radio"/>
                            </HBox>
                        </VBox>

                        <!-- Quantidade -->
                        <VBox spacing="6">
                            <Label styleClass="form-label-required" text="Quantidade *"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="campoQuantidade"
                                           promptText="Ex.: 50"
                                           prefWidth="160"
                                           styleClass="form-field"/>
                                <Label fx:id="labelUnidade"
                                       text=""
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                            </HBox>
                        </VBox>

                        <!-- Motivo (obrigatório para Perda, opcional para outros) -->
                        <VBox spacing="6">
                            <Label fx:id="labelMotivo"
                                   styleClass="form-label"
                                   text="Motivo (opcional)"/>
                            <TextField fx:id="campoMotivo"
                                       promptText="Ex.: Compra do fornecedor"
                                       styleClass="form-field"/>
                        </VBox>

                        <!-- Observações -->
                        <VBox spacing="6">
                            <Label styleClass="form-label" text="Observações"/>
                            <TextArea fx:id="campoObservacoes"
                                      promptText="Informações adicionais..."
                                      prefRowCount="3"
                                      wrapText="true"
                                      styleClass="form-field"/>
                        </VBox>

                        <!-- Status -->
                        <Label fx:id="labelStatus" wrapText="true"
                               style="-fx-font-size: 15px;"/>

                        <!-- Botões -->
                        <HBox spacing="12" alignment="CENTER_RIGHT"
                              style="-fx-padding: 8 0 0 0;">
                            <Button text="Limpar"
                                    onAction="#limpar"
                                    styleClass="btn-voltar"/>
                            <Button fx:id="btnConfirmar"
                                    text="&#10003;  Registrar"
                                    onAction="#registrar"
                                    styleClass="btn-salvar"/>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

            <!-- ════ PAINEL DIREITO: info do material selecionado ════ -->
            <VBox fx:id="painelInfoMaterial"
                  spacing="16"
                  prefWidth="300" minWidth="280" maxWidth="320"
                  visible="false" managed="false"
                  style="-fx-background-color: #FFF0F5; -fx-background-radius: 12;
                         -fx-border-color: #f0d0da; -fx-border-radius: 12;
                         -fx-border-width: 1; -fx-padding: 20;">

                <Label text="Material selecionado"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                              -fx-text-fill: #aaa; -fx-padding: 0 0 4 0;"/>

                <Label fx:id="infoNome"
                       text="—"
                       wrapText="true"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>

                <Separator/>

                <!-- Estoque atual -->
                <VBox styleClass="detalhe-stat-card" spacing="4">
                    <Label text="Estoque atual" styleClass="detalhe-stat-titulo"/>
                    <Label fx:id="infoEstoque" text="—" styleClass="detalhe-stat-valor"/>
                </VBox>

                <!-- Cor + Unidade -->
                <HBox spacing="8">
                    <VBox styleClass="detalhe-stat-card" HBox.hgrow="ALWAYS" spacing="4">
                        <Label text="Cor" styleClass="detalhe-stat-titulo"/>
                        <Label fx:id="infoCor" text="—" styleClass="detalhe-stat-valor"/>
                    </VBox>
                    <VBox styleClass="detalhe-stat-card" HBox.hgrow="ALWAYS" spacing="4">
                        <Label text="Unidade" styleClass="detalhe-stat-titulo"/>
                        <Label fx:id="infoUnidade" text="—" styleClass="detalhe-stat-valor"/>
                    </VBox>
                </HBox>

                <!-- Preço -->
                <VBox styleClass="detalhe-stat-card" spacing="4">
                    <Label text="Preço unitário" styleClass="detalhe-stat-titulo"/>
                    <Label fx:id="infoPreco" text="—" styleClass="detalhe-stat-valor"/>
                </VBox>

                <!-- Preview do novo saldo -->
                <Separator/>
                <VBox fx:id="painelPreviewSaldo" spacing="4" visible="false" managed="false"
                      style="-fx-background-color: white; -fx-background-radius: 8;
                             -fx-border-color: #f0d0da; -fx-border-radius: 8;
                             -fx-border-width: 1; -fx-padding: 10;">
                    <Label text="Novo saldo estimado" styleClass="detalhe-secao-titulo"/>
                    <Label fx:id="infoNovoSaldo" text="—"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>
