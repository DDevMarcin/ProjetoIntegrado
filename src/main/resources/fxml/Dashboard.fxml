<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.managementsystem.demo1.controller.DashboardController"
            style="-fx-background-color: #FFF8FB;">

    <padding>
        <Insets top="32" right="32" bottom="24" left="32"/>
    </padding>

    <!-- ── TOP ── -->
    <top>
        <VBox spacing="4" style="-fx-padding: 0 0 20 0;">
            <Label text="Visão geral do seu negócio"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
        </VBox>
    </top>

    <!-- ── CENTER ── -->
    <center>
        <HBox spacing="20">

            <!-- COLUNA ESQUERDA (Principal: KPIs + Resumo Financeiro + Encomendas Urgentes) -->
            <VBox spacing="18" HBox.hgrow="ALWAYS">

                <!-- Linha 1: 3 Cards de KPIs -->
                <HBox spacing="16">
                    <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16 20; -fx-border-color: #f5d6e0; -fx-border-radius: 14;">
                        <Label text="Pedidos em andamento"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                        <Label fx:id="lblEmAndamento" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                    </VBox>

                    <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16 20; -fx-border-color: #f5d6e0; -fx-border-radius: 14;">
                        <Label text="Pedidos Prontos"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                        <Label fx:id="lblProntos" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                    </VBox>

                    <VBox spacing="6" alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16 20; -fx-border-color: #f5d6e0; -fx-border-radius: 14;">
                        <Label text="Encomendas"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #666;"/>
                        <Label fx:id="lblTotalEncomendas" text="0"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #D31946;"/>
                    </VBox>
                </HBox>

                <!-- Linha 2: Card Resumo Financeiro -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18 24; -fx-border-color: #f5d6e0; -fx-border-radius: 14;">
                    <Label text="Resumo Financeiro"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3b5998;"/>
                    <HBox spacing="24">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Total de Vendas" style="-fx-font-size: 12px; -fx-text-fill: #777;"/>
                            <Label fx:id="lblTotalVendas" text="R$ 0,00"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </VBox>

                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Despesas" style="-fx-font-size: 12px; -fx-text-fill: #777;"/>
                            <Label fx:id="lblTotalDespesas" text="R$ 0,00"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </VBox>

                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Ganhos" style="-fx-font-size: 12px; -fx-text-fill: #777;"/>
                            <Label fx:id="lblGanhos" text="R$ 0,00"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Linha 3: Tabela Encomendas Urgentes -->
                <VBox spacing="0" styleClass="card-tabela" VBox.vgrow="ALWAYS">
                    <Label text="Encomendas Urgentes" styleClass="card-titulo"/>

                    <TableView fx:id="tabelaUrgentes" VBox.vgrow="ALWAYS" styleClass="tabela-produtos">
                        <columns>
                            <TableColumn fx:id="colCliente" text="Cliente / Itens" prefWidth="230"/>
                            <TableColumn fx:id="colSituacao" text="Situação"       prefWidth="110"/>
                            <TableColumn fx:id="colValor"    text="Valor"          prefWidth="100"/>
                            <TableColumn fx:id="colData"     text="Entrega"        prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="Nenhuma encomenda pendente ou em produção." style="-fx-text-fill: #aaa;"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>

            <!-- COLUNA DIREITA (Estoque Baixo + Sem Estoque) -->
            <VBox spacing="18" prefWidth="270" minWidth="270" maxWidth="270">

                <!-- Card Estoque Baixo -->
                <VBox spacing="12" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #f5d6e0; -fx-border-radius: 14;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Estoque Baixo"
                               style="-fx-background-color: #E2E8F0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 5 14; -fx-background-radius: 8;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <VBox fx:id="boxEstoqueBaixo" spacing="10" style="-fx-padding: 4 0;"/>
                        </content>
                    </ScrollPane>
                </VBox>

                <!-- Card Sem Estoque -->
                <VBox spacing="12" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #f5d6e0; -fx-border-radius: 14;">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Sem Estoque"
                               style="-fx-background-color: #FFE4E6; -fx-text-fill: #D31946; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 5 14; -fx-background-radius: 8;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <VBox fx:id="boxSemEstoque" spacing="10" style="-fx-padding: 4 0;"/>
                        </content>
                    </ScrollPane>
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>